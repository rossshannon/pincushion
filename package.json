{
  "name": "pincushion",
  "keywords": [
    "pinboard",
    "pinboard.in",
    "tagging",
    "bookmarks",
    "bookmarking",
    "delicious",
    "bookmarklet"
  ],
  "description": "Pincushion presents an enhanced version of the Pinboard.in 'Add Bookmark' page, which takes advantage of the capabilities of modern browsers",
  "homepage": "https://rossshannon.github.io/pincushion",
  "version": "2.2.0",
  "author": "Ross Shannon <ross.shannon@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:rossshannon/pincushion.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.16.0",
    "dayjs": "^1.11.13",
    "ladda": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.0",
    "react-select": "^5.10.1",
    "react-transition-group": "^4.4.5",
    "react-window": "^1.8.11",
    "redux": "^4.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "browserslist": "^4.22.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.0.3",
    "redux-mock-store": "^1.5.5",
    "redux-thunk": "^2.4.2",
    "source-map-explorer": "^2.5.3",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "trim-newlines": "^5.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"**/*.test.{js,jsx,ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "analyze": "npx source-map-explorer 'build/assets/*.js'"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "**/*.test.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module"
}
